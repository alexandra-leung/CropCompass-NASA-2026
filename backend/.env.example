# Informational deployment metadata; the backend currently does not read these.
APP_NAME=CropCompass
APP_ENV=development

# M2's optional HTTP adapter for the M1 climate API.
M1_API_BASE_URL=http://127.0.0.1:8000

# M4 upstream call timeouts, in seconds.
M4_PROVIDER_TIMEOUT_SECONDS=90
M4_SCENARIOS_TIMEOUT_SECONDS=90
M4_HISTORY_TIMEOUT_SECONDS=30
M4_MODULE_TIMEOUT_SECONDS=30

# Optional assistant LLM. Without the selected provider's key, template answers
# are used. Leave the model empty to use the provider-specific default.
M4_LLM_PROVIDER=anthropic
M4_LLM_MODEL=
M4_LLM_TIMEOUT_SECONDS=20
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# M5 candidate-data mode: 1 requires cached NASA POWER data; 0 allows downloads.
M5_OFFLINE=0
